{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "55",
    "MAX_THINKING_TOKENS": "10000"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dart run scripts/check_alerts.dart"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "dart run --verbosity=error scripts/discipline_hook.dart"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "dart run --verbosity=error scripts/reconcile_ci.dart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dart run --verbosity=error scripts/discipline_hook.dart"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "dart run --verbosity=error scripts/discipline_hook.dart"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dart run --verbosity=error scripts/git_safety_hook.dart"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "dart run --verbosity=error scripts/memory_write_guard_hook.dart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dart run --verbosity=error scripts/batch_close_hook.dart"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dart run --verbosity=error scripts/session_release.dart"
          }
        ]
      }
    ]
  }
}
