# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment
.env
.env.dev
.env.prod

# Claude Code worktrees
.claude/worktrees/
.env.local
supabase/.env

# Supabase Management API access tokens (e.g. supabase/.supabase/supabase access token.txt)
# Used by .claude/deploy_via_api.js — DO NOT commit any token, ever.
supabase/.supabase/

# Edge function deploy payloads (regenerable via .claude/emit_payload.js)
# Contain inlined source — no point checking them in.
.claude/_payload_*.json
.claude/_payload_*.b64
.claude/_payload_*.txt
.claude/_deploy_payload_*.json
.claude/ai-proxy-chunk-*.txt

# Knowledgebase (reference docs, not source code)
Knowledgebase/

# Workspace tooling output / regenerable artifacts (Test #8 cleanup)
analyze_output.txt
flutter_test_output.txt
mockups/
.hermes/
.superpowers/
test/plan_generator/v4_diagnostic_output.md
assets/*.bak
.claude/scheduled_tasks.lock


# Local Claude Code agent permissions — must never be committed.
# Audit C-3 (2026-05-11): this file held a Supabase anon JWT.
.claude/settings.local.json

# Local reference materials (not bundled in APK — bundled assets live in
# assets/data/*.json). Founder's source docs, exercise/food spreadsheets,
# naval rank reference imagery, etc. — useful on disk, never shipped.
assets/*.docx
assets/*.xlsx
assets/*.pdf
assets/calisthenics feature.md
assets/New folder/
assets/naval pics/
