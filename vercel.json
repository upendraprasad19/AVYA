{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/vercel_build.sh",
  "outputDirectory": "build/web",
  "installCommand": "echo no-install",
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in oi/*) exit 0;; esac; exit 1",
  "redirects": [
    { "source": "/admin", "destination": "/#/admin", "permanent": false },
    { "source": "/admin/", "destination": "/#/admin", "permanent": false },
    { "source": "/confirm", "destination": "/#/confirm", "permanent": false },
    { "source": "/confirm/", "destination": "/#/confirm", "permanent": false }
  ],
  "rewrites": [
    { "source": "/((?!\\.well-known/).*)", "destination": "/index.html" }
  ]
}
